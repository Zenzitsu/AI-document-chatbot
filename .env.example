# Qdrant Cloud Credentials
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# Gemini API Key (Used for LLM generation via OpenAI-compatible endpoint or direct API)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# RAG & Qdrant Collection Settings
QDRANT_COLLECTION_NAME=rag_collection
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
